#!/bin/bash

set -eu

# When the script exits, including if a step fails, drop any cached sudo
# credentials. Doing this once here, rather than after each use of sudo, also
# means only asking for a password once. If a step failed, also say so, since
# its error may be buried in the output above (e.g. from the brew installer).
cleanup() {
  local status=$?
  sudo -k
  if [[ ${status} -ne 0 ]]; then
    echo "❌ Setup failed (exit ${status}); fix the error above and rerun."
  fi
}
trap cleanup EXIT

TARGET="${HOME}/config"
CONFIG="https://github.com/mwhoffman/config"
CONFIG_SSH="git@github.com:mwhoffman/config.git"
HOMEBREW="https://raw.githubusercontent.com/Homebrew/install/HEAD/install.sh"

# Check if brew is on our PATH; if not, search for it in the usual places and
# run shellenv to add it. Return unsuccessfully if we can't find it at all.
find_brew() {
  command -v brew >/dev/null 2>&1 && return 0
  local brew
  for brew in \
    /opt/homebrew/bin/brew \
    /usr/local/bin/brew \
    /home/linuxbrew/.linuxbrew/bin/brew
  do
    if [[ -x "${brew}" ]]; then
      eval "$("${brew}" shellenv)"
      return 0
    fi
  done
  return 1
}

# Print those of the given apt packages that are not installed.
missing_apt() {
  local pkg
  for pkg in "$@"; do
    dpkg-query -W -f='${Status}' "${pkg}" 2>/dev/null | grep -q "ok installed" \
      || echo "${pkg}"
  done
}

# Print those of the given brew formulae that are not installed.
missing_brew() {
  local formula
  for formula in "$@"; do
    brew list --formula "${formula}" >/dev/null 2>&1 || echo "${formula}"
  done
}

case $(uname -s) in
  # Macs have git via the command line tools (which the homebrew installer will
  # take care of), so there is nothing else needed here.
  Darwin)
    ;;

  # On linux we need the essentials for homebrew itself as well as git in order
  # to clone this repository. The remaining packages come from homebrew so that
  # we don't depend on the (often outdated) distro versions.
  #
  # Only touch apt if something is actually missing. Note that `apt-get install`
  # will also upgrade packages that are already installed.
  Linux)
    missing=$(missing_apt build-essential procps curl file git)
    if [[ -n "${missing}" ]]; then
      echo "📦 Installing apt packages:" ${missing}
      sudo apt-get update
      sudo apt-get install -y ${missing}
    fi
    ;;

  *)
    echo "❌ Unsupported OS: $(uname -s)"
    exit 1
    ;;
esac

if ! find_brew; then
  # The installer needs sudo, and with NONINTERACTIVE it can't prompt for a
  # password itself, so authenticate (and cache credentials) first.
  echo "📦 Installing homebrew"
  sudo -v

  # This is homebrew's recommended install command, except the installer is
  # downloaded first: the assignment takes curl's exit status, so set -e stops
  # the script if the download fails (or is cut short) rather than running an
  # empty or partial script.
  installer=$(curl -fsSL "${HOMEBREW}")
  NONINTERACTIVE=1 /bin/bash -c "${installer}"

  find_brew || { echo "❌ Could not find brew after installing it."; exit 1; }
fi

# We need just to run the setup and stow to link the dotfiles. Only install what
# is missing since brew would otherwise auto-update and upgrade what's
# installed.
missing=$(missing_brew just stow)
if [[ -n "${missing}" ]]; then
  echo "📦 Installing brew packages:" ${missing}
  brew install ${missing}
fi

# Check the target config directory and try to clone from git. Otherwise fail if
# anything already exists there (including a file or a broken symlink) that
# isn't an existing clone. A clone without an origin remote gets an empty ORIGIN
# rather than git's own error, so it fails with the same message as any other
# origin.
if [[ ! -e "${TARGET}" && ! -L "${TARGET}" ]]; then
  echo "📦 Installing config: ${TARGET}"
  git clone "${CONFIG}" "${TARGET}"

elif [[ ! -d "${TARGET}/.git" ]]; then
  echo "❌ Unknown directory \"${TARGET}\" (not a git directory)."
  exit 1

else
  ORIGIN=$(git -C "${TARGET}" remote get-url origin 2>/dev/null || true)
  if [[ "${ORIGIN}" != "${CONFIG}" && "${ORIGIN}" != "${CONFIG_SSH}" ]]; then
    echo "❌ Unknown directory \"${TARGET}\" (incorrect origin)."
    exit 1
  fi
fi

# Fetch over https, which needs no authentication, but push over ssh. This also
# converts existing clones, and only changes a url if it's wrong so rerunning
# this makes no changes.
FETCH_URL=$(git -C "${TARGET}" remote get-url origin)
if [[ "${FETCH_URL}" != "${CONFIG}" ]]; then
  echo "🔧 Setting config fetch url: ${CONFIG}"
  git -C "${TARGET}" remote set-url origin "${CONFIG}"
fi

# The push url defaults to the fetch url, so only check it after that's fixed.
PUSH_URL=$(git -C "${TARGET}" remote get-url --push origin)
if [[ "${PUSH_URL}" != "${CONFIG_SSH}" ]]; then
  echo "🔧 Setting config push url: ${CONFIG_SSH}"
  git -C "${TARGET}" remote set-url --push origin "${CONFIG_SSH}"
fi

# Run the setup in this same process so that homebrew is in the PATH. Options
# are given with MWCONFIG_* environment variables (see the justfile), which pass
# through to just.
(cd "${TARGET}" && just install && just dotfiles)

# We're done!
echo "🎉 Setup complete! Start a new login shell to pick up any changes."
