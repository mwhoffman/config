* {
  font: "Hack Nerd Font Mono 18";

  /* Gruvbox colors, named as in the i3 config ($bg, $fg, ...); fg1 is
     gruvbox's slightly dimmer foreground, which i3 doesn't use. */
  bg: #282828;
  fg: #fbf1c7;
  fg1: #ebdbb2;
  blue: #458588;
  green: #98971a;
  yellow: #d79921;

  /* What the colors are used for. */
  accent: @blue;   /* The search bar. */
  outline: @blue;  /* The border around the window. */
  selected: @fg1;  /* The selected row. */

  background-color: transparent;
  text-color: inherit;
}

window {
  width: 700px;
  margin: 1px;
  border: 2px;
  border-color: @outline;
  background: @bg;
  text-color: @fg;
}

inputbar {
  spacing: 0;
  padding: 0.5em;
  background-color: @accent;
  children: ["icon-search", "entry"];
}

listview {
  padding: 0.5em;
  background-color: @bg;
}

prompt {
  margin: 0px 10px 0px 11px;
}

icon-search {
  expand: false;
  margin: 0;
  filename: "search";
  size: 1em;
  padding: 0 0 0 0.2em;
}

entry {
  cursor: text;
  padding: 0 0 0 0.2em;
}

element {
  padding: 0.2em;
}

element-icon {
  size: 1em;
}

element-text {
  padding: 0 0 0 0.2em;
}

element selected {
  background-color: @selected;
  text-color: @bg;
}

