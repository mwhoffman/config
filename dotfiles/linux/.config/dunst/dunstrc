# Generated by `bedeck build`.

[global]
# Don't show icons.
icon_position = off
separator_color = frame
frame_color = "#458588"
highlight = "#83a598"
origin = bottom-right
offset = 10x50

# Low urgency is dimmed, like polybar's disabled items.
[urgency_low]
background = "#282828"
foreground = "#a89984"

# Normal urgency has the accent border, like rofi and i3's focused window.
[urgency_normal]
background = "#282828"
foreground = "#ebdbb2"

# Critical urgency has the urgent color as its border.
[urgency_critical]
background = "#282828"
foreground = "#ebdbb2"
frame_color = "#fabd2f"
highlight = "#fabd2f"
