[include]
    path = ~/.config/git/local
    path = ~/.config/git/colors

[user]
    useConfigOnly = true

[color]
    diff = auto
    status = auto

[alias]
    undo = reset --soft HEAD^
    st = status -sb
    ci = commit
    co = checkout
    graph = log --graph --abbrev-commit --date=relative --all --format=format:'%C(bold blue)%h%C(reset) - %s %C(bold yellow)%d%C(reset)'

[push]
    default = simple

[pull]
    ff = only

[init]
    defaultBranch = main

