[include]
    path = ~/.config/git/local

[user]
    useConfigOnly = true

[color]
    diff = auto
    status = auto

# Roughly match gruvbox colors for git status.
[color "status"]
    added = brightgreen
    changed = "#fe8019"
    untracked = "#fe8019"

[alias]
    undo = reset --soft HEAD^
    st = status -sb
    ci = commit
    co = checkout
    graph = log --graph --abbrev-commit --date=relative --all --format=format:'%C(bold blue)%h%C(reset) - %s %C(bold yellow)%d%C(reset)'

[push]
    default = simple

[pull]
    ff = only

[init]
    defaultBranch = main

