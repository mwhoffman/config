[include]
    path = ~/.config/git/local

[user]
    useConfigOnly = true

[color]
    diff = auto
    status = auto

# Colors for git status: green for staged changes and yellow for unstaged ones,
# which eza's theme matches. Untracked files keep git's default red.
[color "status"]
    added = brightgreen
    changed = yellow

[alias]
    undo = reset --soft HEAD^
    st = status -sb
    ci = commit
    co = checkout
    graph = log --graph --abbrev-commit --date=relative --all --format=format:'%C(bold blue)%h%C(reset) - %s %C(bold yellow)%d%C(reset)'

[push]
    default = simple

[pull]
    ff = only

[init]
    defaultBranch = main

