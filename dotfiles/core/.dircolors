# Configuration file for dircolors, a utility to help you set the
# LS_COLORS environment variable used by GNU ls with the --color option.

# The following TERM entries are used to match against the TERM environment
# variable to determine if it is colorizable.
COLORTERM ?*
TERM Eterm
TERM ansi
TERM *color*
TERM *direct*
TERM con[0-9]*x[0-9]*
TERM cons25
TERM console
TERM cygwin
TERM dtterm
TERM gnome
TERM hurd
TERM jfbterm
TERM konsole
TERM kterm
TERM linux
TERM linux-c
TERM mlterm
TERM putty
TERM rxvt*
TERM screen*
TERM st
TERM terminator
TERM tmux*
TERM vt100
TERM xterm*

# We mostly use the bright variants (90-97 for text, 100-107 for backgrounds)
# Directories are the exception: they use the darker blue (#458588).

RESET                  0         # reset to normal color
DIR                    01;34     # directory
LINK                   96        # symlink. "target" uses the linked color.
FIFO                   04;91     # pipe
SOCK                   04;91     # socket
DOOR                   04;91     # door
BLK                    04;91     # block device driver
CHR                    04;91     # character device driver
ORPHAN                 09;96     # orphaned symlink
MISSING                09;91     # ... and the files they point to
SETUID                 30;101    # file that is setuid (u+s)
SETGID                 30;103    # file that is setgid (g+s)
CAPABILITY             00        # file with capability (off: slow to check)
EXEC                   01;92     # file with execute permission
STICKY_OTHER_WRITABLE  30;102    # dir that is sticky and other-writable
OTHER_WRITABLE         30;103    # dir that is other-writable and not sticky
STICKY                 30;104    # dir that is sticky and not other-writable

# What follows are color specifications for individual file extensions. This
# mainly includes groupings for compressed archives and image/audio/video
# files.

